PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/dev_intelligence?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173

# Email OTP / invitations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=Dev Intelligence <your_email@gmail.com>

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth - create an OAuth App in GitHub Developer Settings
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Optional fallback token for server-side GitHub access
# Prefer GitHub OAuth per user for multi-user deployments.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# AI / OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# GitHub App — DevIntelligenceproject
# Create/configure the App in GitHub Developer Settings.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_KEY\\n-----END PRIVATE KEY-----"
GITHUB_APP_INSTALL_URL=https://github.com/apps/devintelligenceproject/installations/new
# Configure this exact URL in the GitHub App's Setup URL field after deployment:
# https://YOUR_BACKEND_HOST/api/github/app/setup
